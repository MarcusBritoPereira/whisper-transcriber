# Runtime
APP_ENV=production
DEV_MODE=false
APP_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
RUN_SCHEMA_CREATE_ON_STARTUP=false

# Backend security
JWT_SECRET=replace-with-strong-random-secret
ENABLE_LEGACY_API_KEYS=false
API_KEYS=
API_KEY_TENANTS=
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_PER_MIN=20
JOB_RETENTION_DAYS=7
MAX_FILE_MB=200
MAX_URL_DOWNLOAD_MB=2048
ALLOWED_DOWNLOAD_DOMAINS=youtube.com,youtu.be,vimeo.com,tiktok.com,instagram.com,twitch.tv,dailymotion.com,facebook.com,fb.watch,kwai.com

# Database / Queue
DATABASE_URL=postgresql://postgres:replace-with-db-password@db:5432/upscribe
POSTGRES_DB=upscribe
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-db-password
REDIS_URL=redis://redis:6379/0

# S3-compatible object storage
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_BUCKET_NAME=upscribe-storage
S3_REGION_NAME=us-east-1

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Payments
ABACATE_API_KEY=replace-with-abacate-api-key
ABACATE_WEBHOOK_SECRET=replace-with-webhook-secret
APPMAX_API_KEY=replace-with-appmax-key
APPMAX_SANDBOX=false
APPMAX_SIGNATURE_SECRET=replace-with-appmax-webhook-secret

# Email
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM_NAME=Transcritor
EMAIL_FROM_ADDRESS=no-reply@example.com
SUPPORT_EMAIL_TO=suporte@example.com

# Optional AI features
HF_TOKEN=
